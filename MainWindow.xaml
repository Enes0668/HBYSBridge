<Window x:Class="HBYSBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="HBYSX Dictation Bridge" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13" Background="#F8FAFC">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ÜST BİLGİ ALANI (İLK GÖRSELİN AYNISI) -->
        <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="14" Margin="0,0,0,10"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Ellipse Width="10" Height="10" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Çalışıyor, port 4547." FontWeight="Bold" FontSize="15" Foreground="#047857"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtDeviceStatus" Text="Cihaz aranıyor..." Foreground="#64748B" FontSize="12"/>
                    <TextBlock Text="Açık ses kaydı ekranı yok." Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <CheckBox Content="Windows ile başlat" Margin="0,0,0,4" Foreground="#334155"/>
                    <TextBlock Text="Bağlı ekran: 1" Foreground="#64748B" FontSize="11" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SEKMELER (DÜĞME ATAMALARI, CİHAZLAR, LOG) -->
        <TabControl Grid.Row="1" Background="White" BorderBrush="#CBD5E1">
            
            <!-- 1. DÜĞME ATAMALARI (BİREBİR İLK GÖRSEL) -->
            <TabItem Header="Düğme atamaları">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="GridMappings" Grid.Row="0" AutoGenerateColumns="False" 
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              HorizontalGridLinesBrush="#F1F5F9" Background="White"
                              BorderThickness="1" BorderBrush="#E2E8F0" RowHeight="32"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Komut" Binding="{Binding CommandName}" Width="260" IsReadOnly="True" FontWeight="Medium"/>
                            <DataGridTextColumn Header="Atanan düğme (değiştirmek için tıklayın)" Binding="{Binding AssignedInput}" Width="*" IsReadOnly="True" Foreground="#2563EB"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        <TextBlock Text="Atamalar bu bilgisayarda saklanır. &quot;Basılı tut&quot; komutlarında düğme bırakılınca işlem durur. Kayıt yetkisi olmayan kullanıcıda (raportör) kayıt komutları yok sayılır."
                                   Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnAssign" Content="Ata" Width="90" Height="28" Margin="0,0,8,0" 
                                    Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnAssign_Click"/>
                            <Button x:Name="BtnRemoveAssign" Content="Atamayı kaldır" Width="110" Height="28" 
                                    Background="#E2E8F0" Foreground="#334155" BorderThickness="0" Cursor="Hand" Click="BtnRemoveAssign_Click"/>
                            <TextBlock x:Name="TxtAssignPrompt" Text="" Foreground="#DC2626" FontWeight="SemiBold" 
                                       VerticalAlignment="Center" Margin="15,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 2. CİHAZLAR (SADECE DONANIM VE TEST) -->
            <TabItem Header="Cihazlar">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <!-- Oyun Kolu -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="🎮 Oyun Kolu (Snopy / Xbox / USB Gamepad)" FontWeight="Bold" FontSize="14" Foreground="#1E293B" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtGamepadName" Text="Cihaz aranıyor..." Foreground="#475569" Margin="0,0,0,8"/>
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Koldan Basılan Tuş:" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="TxtLiveGamepadButton" Text="[Tuşa basın]" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Seri Port Pedal -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14">
                            <StackPanel>
                                <TextBlock Text="🦶 Ayak Pedalı (Seri Port / COM Port)" FontWeight="Bold" FontSize="14" Foreground="#1E293B" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="COM Port:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="CmbPorts" Width="120" Height="26" Margin="0,0,8,0"/>
                                    <Button Content="Yenile" Width="65" Height="26" Margin="0,0,8,0" Click="BtnRefreshPorts_Click"/>
                                    <Button Content="Bağlan" Width="75" Height="26" Background="#10B981" Foreground="White" BorderThickness="0" Click="BtnConnectPort_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtSerialStatus" Text="Pedal aranıyor..." Foreground="#64748B" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 3. LOG (TEST ÇIKTILARI) -->
            <TabItem Header="Log">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListBox x:Name="ListLogs" Grid.Row="0" FontFamily="Consolas" FontSize="11" Background="#0F172A" Foreground="#E2E8F0" BorderThickness="0"/>
                    <Button Content="Logu Temizle" Grid.Row="1" HorizontalAlignment="Right" Width="90" Height="26" Margin="0,8,0,0" Click="BtnClearLog_Click"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
